<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Build produces one native executable per OS: dotnet publish -c Release -->
    <PublishAot>true</PublishAot>
    <!-- Enable AOT compatibility analyzers to catch reflection at compile time -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Packaging (read by .github/workflows/build.yml): exe icon and Windows version resource, .app bundle id. -->
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>RadSharpApp</Product>
    <Company>RadSharpApp</Company>
    <Copyright>Copyright (c) RadSharpApp</Copyright>
    <BundleId>com.example.RadSharpApp</BundleId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RadSharp.Platform.Sdl" Version="RADSHARP_VERSION" />
  </ItemGroup>

</Project>

{
  "format": "radform",
  "version": "1.0",
  "root": {
    "class": "Form",
    "name": "frmMenus",
    "width": 400,
    "height": 300,
    "children": [
      {
        "class": "MainMenu",
        "name": "mnuMain",
        "items": [
          {
            "caption": "File",
            "items": [
              { "caption": "New", "shortcut": "Ctrl+N", "onClick": "mnuNew_Click", "enabled": true },
              { "caption": "-", "separator": true },
              { "caption": "Recent", "items": [ { "caption": "a.map", "name": "mniRecentA" } ] },
              { "caption": "Exit", "onClick": "mnuExit_Click", "visible": true }
            ]
          },
          {
            "caption": "Edit",
            "items": [
              { "caption": "Redo", "shortcut": "Ctrl+Y", "altShortcut": "Ctrl+Shift+Z", "enabled": false },
              { "caption": "Grid", "checked": true }
            ]
          }
        ]
      },
      { "class": "PopupMenu", "name": "pmnList", "left": 20, "top": 200, "items": [ { "caption": "Delete" } ] },
      { "class": "Panel", "name": "pnlList", "popupMenu": "pmnList", "align": "client" },
      { "class": "Timer", "name": "tmrTick", "interval": 250, "left": 60, "top": 200 }
    ]
  }
}

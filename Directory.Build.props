<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Packaging. -->
  <PropertyGroup>
    <!-- A unique pre-release per build: projects reference 0.1.0-dev* and always get the newest local pack.
         Packages depend on each other at their own build's version, so packing several projects must use ONE version:
         run ./pack.ps1 (or ./pack.sh), which stamps it once and passes -p:RadSharpVersion=... to every pack, or pass
         -p:RadSharpVersion=<version> yourself. A bare `dotnet pack` of one project stamps its own minute. -->
    <RadSharpVersion Condition="'$(RadSharpVersion)' == ''">0.1.0-dev.$([System.DateTime]::UtcNow.ToString(yyyyMMddHHmm))</RadSharpVersion>
    <Version>$(RadSharpVersion)</Version>
    <Authors>RadSharp contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <PackageTags>rad;forms;designer;delphi;skia;sdl;ui</PackageTags>
    <Copyright>Copyright (c) 2026 SantasLair</Copyright>
    <PackageProjectUrl>https://github.com/SantasLair/RadSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SantasLair/RadSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/SantasLair/RadSharp/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- The nuget.org page's readme: absolute links only (the repo README's relative links and images break there). -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)docs/package-readme.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>
</Project>

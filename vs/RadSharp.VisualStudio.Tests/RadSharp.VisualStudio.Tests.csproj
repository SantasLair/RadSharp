<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the VSIX logic that doesn't need Visual Studio (vs/RadSharp.VisualStudio/Logic). Those files are compiled
       in here directly: referencing the VSIX project would drag in the VS SDK. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>RadSharp.VisualStudio.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RadSharp.VisualStudio\Logic\*.cs" Link="Logic\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>

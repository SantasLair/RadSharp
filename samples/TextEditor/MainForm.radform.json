{
  "format": "radform",
  "version": "1.0",
  "generator": "hand-written",
  "root": {
    "class": "Form",
    "name": "frmEditor",
    "caption": "Untitled — Text Editor",
    "width": 720,
    "height": 480,
    "onCloseQuery": "frmEditor_CloseQuery",
    "children": [
      {
        "class": "MainMenu",
        "name": "mnuMain",
        "items": [
          {
            "caption": "File",
            "items": [
              {
                "caption": "New",
                "onClick": "mnuNew_Click",
                "shortcut": "Mod+N"
              },
              {
                "caption": "Open…",
                "onClick": "mnuOpen_Click",
                "shortcut": "Mod+O"
              },
              {
                "caption": "Save",
                "onClick": "mnuSave_Click",
                "shortcut": "Mod+S"
              },
              {
                "caption": "Save as…",
                "onClick": "mnuSaveAs_Click",
                "shortcut": "Mod+Shift+S"
              },
              {
                "caption": "-",
                "separator": true
              },
              {
                "caption": "Exit",
                "onClick": "mnuExit_Click"
              }
            ]
          },
          {
            "caption": "Edit",
            "items": [
              {
                "caption": "Undo",
                "onClick": "mnuUndo_Click",
                "shortcut": "Mod+Z"
              },
              {
                "caption": "Redo",
                "onClick": "mnuRedo_Click",
                "shortcut": "Mod+Y"
              },
              {
                "caption": "-",
                "separator": true
              },
              {
                "caption": "Cut",
                "onClick": "mnuCut_Click",
                "shortcut": "Mod+X"
              },
              {
                "caption": "Copy",
                "onClick": "mnuCopy_Click",
                "shortcut": "Mod+C"
              },
              {
                "caption": "Paste",
                "onClick": "mnuPaste_Click",
                "shortcut": "Mod+V"
              },
              {
                "caption": "-",
                "separator": true
              },
              {
                "caption": "Select all",
                "onClick": "mnuSelectAll_Click",
                "shortcut": "Mod+A"
              }
            ]
          },
          {
            "caption": "Search",
            "items": [
              {
                "caption": "Find…",
                "onClick": "mnuFind_Click",
                "shortcut": "Mod+F"
              },
              {
                "caption": "Replace…",
                "onClick": "mnuReplace_Click",
                "shortcut": "Mod+H"
              },
              {
                "caption": "Find next",
                "onClick": "mnuFindNext_Click",
                "shortcut": "F3"
              }
            ]
          },
          {
            "caption": "View",
            "items": [
              {
                "caption": "Line numbers",
                "onClick": "mnuLineNumbers_Click",
                "name": "mniLineNumbers",
                "checked": true
              },
              {
                "caption": "C# colours",
                "onClick": "mnuCSharp_Click",
                "name": "mniCSharp",
                "checked": true
              }
            ]
          }
        ]
      },
      {
        "class": "StatusBar",
        "name": "sbMain"
      },
      {
        "class": "CodeEditor",
        "name": "edCode",
        "align": "client",
        "onTextChanged": "edCode_TextChanged",
        "onCaretMoved": "edCode_CaretMoved"
      },
      {
        "class": "OpenDialog",
        "name": "dlgOpen",
        "filter": "Text and code|*.txt;*.md;*.cs;*.json|All files|*.*",
        "left": 20,
        "top": 60
      },
      {
        "class": "SaveDialog",
        "name": "dlgSave",
        "filter": "Text and code|*.txt;*.md;*.cs;*.json|All files|*.*",
        "left": 60,
        "top": 60
      }
    ]
  }

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Golden/ holds form files used as test data, not as app forms. -->
    <RadSharpFormsExclude>Golden\**</RadSharpFormsExclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RadSharp.Core\RadSharp.Core.csproj" />
    <ProjectReference Include="..\..\src\RadSharp.Generators\RadSharp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\src\RadSharp.Core\build\RadSharp.Core.targets" />

  <ItemGroup>
    <None Include="..\..\spec\vectors\**\*.json" LinkBase="vectors" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

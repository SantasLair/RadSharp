<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RadSharp.Designer\RadSharp.Designer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The live-run fixture project (ProjectControlsTests copies it to a temp folder before opening it). -->
  <ItemGroup>
    <None Include="..\Fixtures\TallyLive\**\*" Exclude="..\Fixtures\TallyLive\**\bin\**;..\Fixtures\TallyLive\**\obj\**"
          LinkBase="Fixtures\TallyLive" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

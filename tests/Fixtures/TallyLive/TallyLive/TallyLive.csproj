<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test fixture for live runs (F9) with the project's real dependencies: a NuGet package with native assets
    (Microsoft.Data.Sqlite → e_sqlite3), a System.Text.Json JsonSerializerContext (the targeting pack's generator),
    a project reference, a <Using> item, a define and a control class of its own.
    The test copies it to a temp folder and writes a Directory.Build.props there that sets RadSharpBin (the test's
    output folder), so RadSharp comes from the same build the designer runs on.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tally</RootNamespace>
    <PublishAot>true</PublishAot>
    <DefineConstants>$(DefineConstants);TALLY_LIVE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <ProjectReference Include="..\TallyLive.Lib\TallyLive.Lib.csproj" />
    <Using Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(RadSharpBin)RadSharp.Core.dll" />
    <Reference Include="$(RadSharpBin)SkiaSharp.dll" />
    <Reference Include="$(RadSharpBin)HarfBuzzSharp.dll" />
    <!-- As the RadSharp.Core package adds it; the live run must not run it twice. -->
    <Analyzer Include="$(RadSharpBin)RadSharp.Generators.dll" />
  </ItemGroup>

</Project>

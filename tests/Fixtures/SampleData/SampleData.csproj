<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A library the sample controls use: the designer loads it from the project's output folder. It is also a small
    component library (Swatch): its controls come onto the palette under its own name.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\RadSharp.Core\RadSharp.Core.csproj" />
    <ProjectReference Include="..\..\..\src\RadSharp.Generators\RadSharp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

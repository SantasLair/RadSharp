<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The designer compiles projects with Roslyn (live run), so it runs on the JIT, not NativeAOT. -->
    <RootNamespace>RadSharp.Designer</RootNamespace>
    <AssemblyName>RadSharpDesigner</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RadSharp.Design.Code\RadSharp.Design.Code.csproj" />
    <ProjectReference Include="..\RadSharp.Platform.Sdl\RadSharp.Platform.Sdl.csproj" />
    <ProjectReference Include="..\RadSharp.Generators\RadSharp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\RadSharp.Core\build\RadSharp.Core.targets" />

</Project>
